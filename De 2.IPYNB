    "import os\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Hàm hiển thị ảnh\n",
    "def show_image(img, title=\"Ảnh\", figsize=(8, 6)):\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# Dùng đúng tên ảnh bạn đã có\n",
    "image_path = 'thuyen.jpg'\n",
    "image_name = os.path.splitext(os.path.basename(image_path))[0]\n",
    "\n",
    "# Kiểm tra file ảnh có tồn tại không\n",
    "if not os.path.exists(image_path):\n",
    "    print(\"Không tìm thấy ảnh:\", image_path)\n",
    "    exit()\n",
    "\n",
    "# Đọc ảnh\n",
    "img = cv2.imread(image_path)\n",
    "\n",
    "if img is None:\n",
    "    print(\"Không đọc được ảnh. Có thể ảnh bị hỏng.\")\n",
    "    exit()\n",
    "\n",
    "# 1. Làm mịn bằng Bilateral Filter\n",
    "bilateral = cv2.bilateralFilter(img, d=9, sigmaColor=75, sigmaSpace=75)\n",
    "cv2.imwrite(f\"{image_name}_bilateral.jpg\", bilateral)\n",
    "show_image(bilateral, \"1. Bilateral Filter\")\n",
    "\n",
    "# 2. Edge Detection bằng Canny\n",
    "gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
    "edges = cv2.Canny(gray, threshold1=100, threshold2=200)\n",
    "cv2.imwrite(f\"{image_name}_edges.jpg\", edges)\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.imshow(edges, cmap='gray')\n",
    "plt.title(\"2. Canny Edge Detection\")\n",
    "plt.axis('off')\n",
    "plt.show()\n",
    "\n",
    "# 3. Hoán đổi kênh màu BGR -> BRG\n",
    "swapped = img.copy()\n",
    "swapped[:, :, [1, 2]] = swapped[:, :, [2, 1]]  # G <-> R\n",
    "cv2.imwrite(f\"{image_name}_swapped.jpg\", swapped)\n",
    "show_image(swapped, \"3. Swap Channels BGR -> BRG\")\n",
    "\n",
    "# 4. Chuyển sang YCrCb và tách kênh\n",
    "ycrcb = cv2.cvtColor(img, cv2.COLOR_BGR2YCrCb)\n",
    "Y, Cr, Cb = cv2.split(ycrcb)\n",
    "cv2.imwrite(f\"{image_name}_Y.jpg\", Y)\n",
    "cv2.imwrite(f\"{image_name}_Cr.jpg\", Cr)\n",
    "cv2.imwrite(f\"{image_name}_Cb.jpg\", Cb)\n",
    "\n",
    "# Hiển thị từng kênh\n",
    "plt.figure(figsize=(15, 5))\n",
    "plt.subplot(1, 3, 1)\n",
    "plt.imshow(Y, cmap='gray')\n",
    "plt.title(\"4a. Kênh Y\")\n",
    "plt.axis('off')\n",
    "\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.imshow(Cr, cmap='gray')\n",
    "plt.title(\"4b. Kênh Cr\")\n",
    "plt.axis('off')\n",
    "\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.imshow(Cb, cmap='gray')\n",
    "plt.title(\"4c. Kênh Cb\")\n",
    "plt.axis('off')\n",
    "plt.show()\n"
