    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Hàm hiển thị ảnh với matplotlib (không bị co hình)\n",
    "def show_image(img, title, figsize=(10, 8)):\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n",
    "    plt.title(title)\n",
    "    plt.axis('off')\n",
    "    plt.show()\n",
    "\n",
    "# Đọc ảnh đầu vào\n",
    "img1 = cv2.imread('duahau.jpg')\n",
    "img2 = cv2.imread('dudu.jpg')\n",
    "img3 = cv2.imread('kiwi.jpg')\n",
    "\n",
    "# Kiểm tra ảnh tồn tại\n",
    "if img1 is None or img2 is None or img3 is None:\n",
    "    print(\"Một hoặc nhiều ảnh không tồn tại!\")\n",
    "    exit()\n",
    "\n",
    "# ---- 1. Thêm viền đen 20 pixel cho ảnh đầu tiên ----\n",
    "bordered = cv2.copyMakeBorder(img1, 20, 20, 20, 20, cv2.BORDER_CONSTANT, value=(0, 0, 0))\n",
    "show_image(bordered, \"Ảnh 1 - Thêm viền đen\")\n",
    "cv2.imwrite('result_img1_bordered.jpg', bordered)\n",
    "\n",
    "# ---- 2. Xoay ảnh thứ hai 45 độ và phóng to 1.5 lần ----\n",
    "scale = 1.5\n",
    "angle = 45\n",
    "h2, w2 = img2.shape[:2]\n",
    "center = (w2 // 2, h2 // 2)\n",
    "M = cv2.getRotationMatrix2D(center, angle, scale)\n",
    "rotated = cv2.warpAffine(img2, M, (int(w2 * scale), int(h2 * scale)))\n",
    "show_image(rotated, \"Ảnh 2 - Xoay 45 độ & zoom 1.5x\")\n",
    "cv2.imwrite('result_img2_rotated.jpg', rotated)\n",
    "\n",
    "# ---- 3. Tăng kích thước ảnh thứ ba lên 4 lần ----\n",
    "print(\"Kích thước ảnh gốc:\", img3.shape)\n",
    "img3_up = cv2.resize(img3, None, fx=4.0, fy=4.0, interpolation=cv2.INTER_LINEAR)\n",
    "print(\"Kích thước ảnh phóng to 4x:\", img3_up.shape)\n",
    "cv2.imwrite('check_img3_up.jpg', img3_up)  # để kiểm tra bằng tay\n",
    "show_image(img3_up, \"Ảnh 3 - Phóng to 4x\", figsize=(12, 10))\n",
    "cv2.imwrite('result_img3_upscaled.jpg', img3_up)\n",
    "\n",
    "# ---- Áp dụng Bilateral Filter ----\n",
    "filtered = cv2.bilateralFilter(img3_up, d=9, sigmaColor=75, sigmaSpace=75)\n",
    "show_image(filtered, \"Ảnh 3 - Sau lọc Bilateral\", figsize=(12, 10))\n",
    "cv2.imwrite('result_img3_filtered.jpg', filtered)\n",
    "\n",
    "# ---- 4. Tăng sáng & tương phản ----\n",
    "alpha = 1.8  # tương phản\n",
    "beta = 40    # độ sáng\n",
    "adjusted = cv2.convertScaleAbs(filtered, alpha=alpha, beta=beta)\n",
    "show_image(adjusted, \"Ảnh 3 - Tăng sáng + tương phản\", figsize=(12, 10))\n",
    "cv2.imwrite('result_img3_final_adjusted.jpg', adjusted)\n",
    "\n",
    "\n"
